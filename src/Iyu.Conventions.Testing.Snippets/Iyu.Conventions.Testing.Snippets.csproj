<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Iyu.Conventions.Testing.Snippets</PackageId>
    <Description>Compiles the C# examples in a repository's Markdown (README, docs) from its own test project, so an example that no longer matches the library fails a test. Reads csharp/cs/c# fences (including inside blockquotes), assembles each as a top-level program with the repository's usings and stand-in declarations, compiles it with Roslyn, and checks a roster of deliberate fragments. A separate package from Iyu.Conventions.Testing because it depends on Microsoft.CodeAnalysis.CSharp.</Description>
    <PackageTags>testing;conventions;documentation;readme;snippets;roslyn</PackageTags>
    <!-- TODO(release): not packable until the kit release that ships it (0.8.0). While it is packable at the declared version
         0.7.0, which is already on nuget.org without it, the release tooling reads the 0.7.0 family as partially published:
         sibling re-pins hold and a sync push waits for an index that never comes. Remove this line in the version-bump commit. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
