<Project Sdk="Microsoft.NET.Sdk">

  <!-- A synthetic library the scanner's tests scan; never packed. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the fixtures use [LoggerMessage]; the package itself reads the attribute by name. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- Only the fixtures implement IValidateOptions<T>; the package recognises it by name. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

</Project>
